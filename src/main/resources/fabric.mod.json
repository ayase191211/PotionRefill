  "authors": [
    "Swench"
  ],
  "contact": {
    "sources": "https://github.com/Swench44/PotionRefill"
  },
  "license": "All-Rights-Reserved",
  "icon": "assets/potionrefill/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.swench.potionrefill.PotionRefill"
    ],
    "modmenu": [
